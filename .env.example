# App
NODE_ENV=production
PORT=3001

# IA (iarouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://iarouter.softcomia.com/v1
OPENAI_MODEL=arnaldo-combo

# Postgres externo (Supabase / PgBouncer). NÃO sobe no stack.
DATABASE_URL=

# SoftFlow (API externa; o browser NÃO usa este caminho)
SOFTFLOW_API_URL=
SOFTFLOW_LOGIN_EMAIL=
SOFTFLOW_LOGIN_SENHA=

# CORS (origens do casos-front na Skadi). Em local, acrescente http://localhost:3000
CORS_ORIGINS=https://softflow.hostsoftcom.cloud,http://softflow.hostsoftcom.cloud

# Traefik / Cloudflare Tunnel (origem HTTP :80)
TRAEFIK_HOST=assistant.hostsoftcom.cloud
TRAEFIK_NETWORK=network_public
TRAEFIK_ENTRYPOINT=web
